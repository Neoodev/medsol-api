generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["inventory", "medicine", "modules", "sales", "users"]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("users")
}

model Module {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(50)
  description String      @db.VarChar(150)
  createdAt   DateTime    @default(now())
  updatedat   DateTime    @updatedAt
  subModules  SubModule[]

  @@schema("modules")
}

model SubModule {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(50)
  description String @db.VarChar(150)
  moduleId    Int
  module      Module @relation(fields: [moduleId], references: [id])

  @@schema("modules")
}

model Medicine {
  id                    Int               @id @default(autoincrement())
  barCode               String?
  itemCode              String
  manuFacturer          String?
  purchaseDate          DateTime?
  serialNumber          String?
  productionDate        DateTime?
  fileId                Int?
  categoryId            Int
  pharmacologicId       Int
  genericId             Int
  brandId               Int
  medicineSalesInfoIdId Int
  inventoryId           Int
  unitId                Int
  createdAt             DateTime          @default(now())
  updatedat             DateTime          @updatedAt
  brand                 Brand             @relation(fields: [brandId], references: [id])
  category              Category          @relation(fields: [categoryId], references: [id])
  file                  File?             @relation(fields: [fileId], references: [id])
  generic               Generic           @relation(fields: [genericId], references: [id])
  inventory             Inventory         @relation(fields: [inventoryId], references: [id])
  salesInfo             MedicineSalesInfo @relation(fields: [medicineSalesInfoIdId], references: [id])
  pharmacologic         Pharmacologic     @relation(fields: [pharmacologicId], references: [id])
  unit                  Unit              @relation(fields: [unitId], references: [id])

  @@index([barCode])
  @@index([itemCode])
  @@index([categoryId])
  @@index([pharmacologicId])
  @@index([genericId])
  @@index([brandId])
  @@index([medicineSalesInfoIdId])
  @@index([inventoryId])
  @@index([unitId])
  @@schema("medicine")
}

model Pharmacologic {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(50)
  description String     @db.VarChar(150)
  createdAt   DateTime   @default(now())
  updatedat   DateTime   @updatedAt
  medicine    Medicine[]

  @@schema("medicine")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(50)
  description String     @db.VarChar(150)
  createdAt   DateTime   @default(now())
  updatedat   DateTime   @updatedAt
  medicine    Medicine[]

  @@schema("medicine")
}

model Generic {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(50)
  description String     @db.VarChar(150)
  createdAt   DateTime   @default(now())
  updatedat   DateTime   @updatedAt
  medicine    Medicine[]

  @@schema("medicine")
}

model Brand {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(50)
  description String     @db.VarChar(150)
  createdAt   DateTime   @default(now())
  updatedat   DateTime   @updatedAt
  medicine    Medicine[]

  @@schema("medicine")
}

model Unit {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(50)
  description String     @db.VarChar(150)
  createdAt   DateTime   @default(now())
  updatedat   DateTime   @updatedAt
  medicine    Medicine[]

  @@schema("medicine")
}

model Inventory {
  id                Int             @id @default(autoincrement())
  inventoryStatusId Int
  qty               Int
  section           String
  expirynDate       DateTime
  status            InventoryStatus @relation(fields: [inventoryStatusId], references: [id])
  medicine          Medicine[]

  @@schema("inventory")
}

model InventoryStatus {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(50)
  description String      @db.VarChar(150)
  inventory   Inventory[]

  @@schema("inventory")
}

model Sales {
  id             Int                 @id @default(autoincrement())
  receiptNo      String              @unique
  totalAmount    Decimal
  cashier        String
  amountTendered Decimal
  change         Decimal
  paymentId      Int
  fileId         Int
  purchaseate    DateTime
  createdAt      DateTime            @default(now())
  updatedat      DateTime            @updatedAt
  file           File                @relation(fields: [fileId], references: [id])
  payment        Payment             @relation(fields: [paymentId], references: [id])
  items          SalesPurchaseItem[]

  @@index([receiptNo])
  @@schema("sales")
}

model SalesPurchaseItem {
  id        Int      @id @default(autoincrement())
  itemCode  String
  qty       Int
  unitPrice Decimal
  total     Decimal
  subTotal  Decimal
  note      String
  salesId   Int
  createdAt DateTime @default(now())
  updatedat DateTime @updatedAt
  sales     Sales    @relation(fields: [salesId], references: [id])

  @@schema("sales")
}

model Payment {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  description String   @db.VarChar(150)
  eWalletId   Int
  createdAt   DateTime @default(now())
  updatedat   DateTime @updatedAt
  ewallet     EWallet  @relation(fields: [eWalletId], references: [id])
  sales       Sales[]

  @@schema("sales")
}

model EWallet {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  description String    @db.VarChar(150)
  createdAt   DateTime  @default(now())
  updatedat   DateTime  @updatedAt
  payment     Payment[]

  @@schema("sales")
}

model MedicineSalesInfo {
  id            Int        @id @default(autoincrement())
  purchasePrice Decimal
  sellingPrice  Decimal
  discountId    Int
  createdAt     DateTime   @default(now())
  updatedat     DateTime   @updatedAt
  medicine      Medicine[]
  discount      Discount   @relation(fields: [discountId], references: [id])

  @@schema("sales")
}

model Discount {
  id          Int                 @id @default(autoincrement())
  name        String              @db.VarChar(50)
  description String              @db.VarChar(150)
  createdAt   DateTime            @default(now())
  updatedat   DateTime            @updatedAt
  salesInfoId MedicineSalesInfo[]

  @@schema("sales")
}

model FileType {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  description String   @db.VarChar(150)
  createdAt   DateTime @default(now())
  updatedat   DateTime @updatedAt
  file        File[]

  @@schema("medicine")
}

model File {
  id          Int        @id @default(autoincrement())
  fileName    String
  objectKey   String     @unique
  url         String
  fileTypeId  Int
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  fileType    FileType   @relation(fields: [fileTypeId], references: [id])
  medicine    Medicine[]
  sales       Sales[]

  @@index([fileTypeId])
  @@index([createdAt])
  @@schema("medicine")
}
